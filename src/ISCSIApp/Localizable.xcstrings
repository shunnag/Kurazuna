          }
        }
      }
    },
    "%@ couldn’t check its file system extension. Click Check Again. If the problem continues, reinstall %@.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のファイルシステム機能拡張を確認できませんでした。“もう一度確認”をクリックしてください。問題が解決しない場合は、%@を再インストールしてください。"
          }
        }
      }
    },
    "In System Settings > General > Login Items & Extensions, click By Category, click File System Extensions, then check that %@ is enabled. If it’s already enabled, eject any connected iSCSI disks and restart your Mac, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“システム設定”＞“一般”＞“ログイン項目と機能拡張”で“カテゴリ別”をクリックし、“ファイルシステム機能拡張”で%@が有効になっていることを確認してください。すでに有効な場合は、接続中のiSCSIディスクを取り出し、Macを再起動してからやり直してください。"
          }
        }
      }
    },
